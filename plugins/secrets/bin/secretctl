@media (prefers-color-scheme:dark){{:root{{--bg:#262624;--card:#30302e;--field:#262624;--line:#3e3e38;--line2:#4a4a44;
--text:#faf9f5;--muted:#c2c0b6;--faint:#9c9a92;--soft:#262624;--ok:#9db37f}}}}
