.tick{{color:var(--ok);font-weight:700;margin-right:6px}}.ok{{margin:0 0 14px;color:var(--ok)}}
</style></head><body><main>{body}</main></body></html>"""

SPARK = ('<svg class="spark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" '
         'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"/>'
         '<path d="M10.85 12.15 19 4m-3 3 2 2m-4.5-.5 2 2"/></svg>')


def key_card(it: dict) -> str:
    n = html.escape(it["name"])
    parts = [f'<section class="key"><code>{n}</code>']
    if it.get("why"):
        parts.append(f'<p class="why">{html.escape(it["why"])}</p>')
    if it.get("steps"):
        parts.append("<ol>" + "".join(f"<li>{html.escape(s)}</li>" for s in it["steps"]) + "</ol>")
    if it.get("where"):
        label = html.escape(urllib.parse.urlparse(it["where"]).netloc or it["where"])
        parts.append(f'<a class="go" href="{html.escape(it["where"], quote=True)}" target="_blank" '
                     f'rel="noopener noreferrer">Get it from {label} &#8599;</a>')
    parts.append(
        f'<input id="v_{n}" type="password" name="v_{n}" placeholder="Paste value" spellcheck="false" autocomplete="off">'
        f'<textarea id="m_{n}" name="m_{n}" placeholder="Paste multi-line value (PEM, JSON…)" spellcheck="false"></textarea>'
        f'<span class="ml" data-k="{n}">Multi-line value?</span></section>')
    return "".join(parts)


SCRIPT = """<script>
document.querySelectorAll('.ml').forEach(function(el){el.addEventListener('click',function(){
var k=el.getAttribute('data-k');document.getElementById('v_'+k).style.display='none';
var t=document.getElementById('m_'+k);t.style.display='block';t.focus();el.remove();});});
var f=document.querySelector('input[type=password]');if(f)f.focus();
</script>"""


def scope_html(scope: store.Scope) -> str:
    if scope.is_global:
        return "Shared by <b>every project</b>"
    return f"For project <b>{html.escape(scope.label)}</b>"


def render_form(items: list[dict], host: str, expires: float, saved: list[str], error: str,
                scope: store.Scope) -> str:
    many = len(items) > 1
    title = f"{len(items)} secrets requested" if many else "Secret requested"
    body = [f'<div class="head">{SPARK}<h1>{title}</h1></div>',
            f'<p class="sub">{scope_html(scope)}. Saved on <b>{html.escape(host)}</b> only, '
            'and never shown to the agent.</p>']
    if saved:
        body.append('<p class="ok">'
                    + "".join(f'<span class="tick">&#10003;</span>{html.escape(s)} saved<br>' for s in saved) + "</p>")
    if error:
        body.append(f'<p class="err">{html.escape(error)}</p>')
    body.append('<form method="post" autocomplete="off">' + "".join(key_card(it) for it in items))
    body.append(f'<button type="submit">{"Save secrets" if many else "Save secret"}</button></form>')
    exp = time.strftime("%H:%M", time.localtime(expires))
    hint = " You can save some now and come back for the rest." if many else ""
    body.append(f'<p class="note">One-time link, expires {exp}.{hint}</p>{SCRIPT}')
    return "".join(body)


def render_done(names: list[str], host: str, scope: store.Scope) -> str:
    rows = "".join(f'<section class="key"><span class="tick">&#10003;</span><code>{html.escape(n)}</code></section>'
                   for n in names)
    return (f'<div class="head">{SPARK}<h1>All set</h1></div>'
            f'<p class="sub">{scope_html(scope)}. Stored on <b>{html.escape(host)}</b>. '
            f'You can close this tab.</p>{rows}')


def make_handler(items: list[dict], token: str, expires: float, remaining, on_done, scope: store.Scope):
    path_ok = f"/s/{token}"
    host = socket.gethostname()
    by_name = {it["name"]: it for it in items}

    class H(http.server.BaseHTTPRequestHandler):
        server_version = "secretctl"
        sys_version = ""

        def log_message(self, *a):
            pass

        def _send(self, code: int, body: str, title: str = "secretctl"):
            data = PAGE.format(title=html.escape(title), body=body).encode()
            self.send_response(code)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Content-Security-Policy",
                             "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'self'")
            self.end_headers()
            self.wfile.write(data)

        def _gone(self):
            self._send(404, f'<div class="head">{SPARK}<h1>Link expired</h1></div>'
                            '<p class="sub">This link is invalid, already used, or has expired.</p>')

        def _form(self, saved=None, error="", code=200):
            left = [by_name[n] for n in remaining()]
            if not left:
                return self._send(200, render_done(list(by_name), host, scope), "Saved · secretctl")
            title = left[0]["name"] if len(left) == 1 else f"{len(left)} secrets"
            self._send(code, render_form(left, host, expires, saved or [], error, scope),
                       f"{title} · secretctl")

        def do_GET(self):
            if self.path.split("?")[0] != path_ok or not remaining():
                return self._gone()
            self._form()

        def do_POST(self):
            if self.path.split("?")[0] != path_ok or not remaining():
                return self._gone()
            n = int(self.headers.get("Content-Length") or 0)
            if n <= 0 or n > MAX_BODY:
                return self._form(error="Values are empty or too large.", code=400)
            form = urllib.parse.parse_qs(self.rfile.read(n).decode("utf-8", "replace"), keep_blank_values=True)
            saved = []
            for name in remaining():
                v = form.get(f"m_{name}", [""])[0] or form.get(f"v_{name}", [""])[0]
                v = v.strip() if "\n" not in v.strip() else v.strip("\n")
                if v.strip():
                    store.save(scope, name, v, note=by_name[name].get("why", ""))
                    clear_pending(scope, name, token)
                    saved.append(name)
            if not saved:
                return self._form(error="Paste at least one value first.", code=400)
            if not remaining():
                self._send(200, render_done(list(by_name), host, scope), "Saved · secretctl")
                on_done()
            else:
                self._form(saved=saved)

    return H


def cmd_serve(a):
    """Internal: serve the one-time page until every key is in, or it expires."""
    items, token = json.loads(a.spec), a.token
    scope = store.Scope.from_dict(json.loads(a.scope))
    names = [it["name"] for it in items]
    bind = os.environ.get("SECRETCTL_BIND", "127.0.0.1")
    pref = int(os.environ.get("SECRETCTL_PORT", DEFAULT_PORT))
    expires = time.time() + a.timeout
    stop = threading.Event()

    def remaining():
        out = []
        for n in names:
            p = read_pending(scope, n)
            if p and p.get("token") == token:
                out.append(n)
        return out

    handler = make_handler(items, token, expires, remaining, stop.set, scope)
    srv = None
    for port in ([pref, 0] if pref else [0]):
        try:
            srv = http.server.ThreadingHTTPServer((bind, port), handler)
            break
        except OSError:
            continue
    if srv is None:
        sys.exit(1)
    port = srv.server_address[1]
    url_host = os.environ.get("SECRETCTL_URL_HOST") or ("localhost" if bind in ("127.0.0.1", "0.0.0.0", "::") else bind)
    url = f"http://{url_host}:{port}/s/{token}"
    for it in items:
        store._write_private(store.pending_path(scope, it["name"], create=True), {
            "name": it["name"], "token": token, "pid": os.getpid(), "port": port, "url": url,
            "why": it["why"], "guide": {"where": it["where"], "steps": it["steps"]},
            "group": names, "scope": scope.to_dict(), "expires": expires, "created": time.time()})
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    while not stop.wait(1.0):
        if time.time() > expires or not remaining():
            break
    time.sleep(0.4)  # let the last page flush
    srv.shutdown()
    for n in names:
        clear_pending(scope, n, token)


# ---------------------------------------------------------------- commands

def print_instructions(items: list[dict], url: str, port: int, scope: store.Scope):
    host = socket.gethostname()
    names = [it["name"] for it in items]
    label = names[0] if len(names) == 1 else f"{len(names)} secrets"
    print(f"Requested {', '.join(names)} {where(scope)}. Waiting for the user. Relay this to them:\n")
    print(f"  Open {url} to enter {label} {where(scope)}")
    sets = " ".join(names)
    print(f"  (or run `secretctl set {sets}{scope_flag(scope)}` in a terminal on {host})\n")
    for it in items:
        if it["steps"] or it["where"]:
            print(f"  Where to find {it['name']}:")
            for i, s in enumerate(it["steps"], 1):
                print(f"    {i}. {s}")
            if it["where"]:
                print(f"    → {it['where']}")
            print()
    bind = os.environ.get("SECRETCTL_BIND", "127.0.0.1")
    if os.environ.get("SSH_CONNECTION") and bind == "127.0.0.1" and not is_orbstack():
        print(f"  Remote machine: the link needs a port forward, e.g. `ssh -L {port}:localhost:{port} {host}`,")
        print("  or set SECRETCTL_BIND to this machine's Tailscale IP. The terminal option always works.\n")
    print(f"Then run: secretctl wait {sets}{' --global' if scope.is_global else ''}")


def try_open(url: str):
    if os.environ.get("SECRETCTL_NO_OPEN"):
        return
    opener = None
    if sys.platform == "darwin":
        opener = "open"
    elif (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) and shutil.which("xdg-open"):
        opener = "xdg-open"
    if opener:
        try:
            subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


def cmd_request(a):
    scope = scope_of(a)
    items = load_spec(a)
    have, shared = [], []
    if not a.replace:
        for it in items:
            e, s = store.find(scope, it["name"])
            if e:
                (have if s == scope else shared).append(it["name"])
    for n in have:
        print(f"{n} is already stored {where(scope)}. Use it with: secretctl run {n} -- <command>")
    for n in shared:
        print(f"{n} is not stored for project {scope.label}, but a global {n} (shared by every project) is, "
              f"and `secretctl run {n}` will use it. Check with the user that the shared key is right here. "
              f"If this project needs its own, run: secretctl request {n} --replace")
    items = [it for it in items if it["name"] not in have and it["name"] not in shared]
    if not items:
        if have:
            print("(Pass --replace to ask the user for new values.)")
        return 0
    # Same set already waiting on a live page? Just show it again.
    ps = [read_pending(scope, it["name"]) for it in items]
    if all(pending_live(p) for p in ps) and len({p["token"] for p in ps}) == 1:
        print_instructions(items, ps[0]["url"], ps[0]["port"], scope)
        return 0
    token = pysecrets.token_urlsafe(18)
    cmd = [sys.executable, os.path.realpath(__file__), "_serve", "--token", token,
           "--timeout", str(a.ttl), "--spec", json.dumps(items), "--scope", json.dumps(scope.to_dict())]
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    first = items[0]["name"]
    for _ in range(100):
        p = read_pending(scope, first)
        if p and p.get("token") == token:
            break
        time.sleep(0.1)
    else:
        die("could not start the request page. Ask the user to run "
            f"`secretctl set {' '.join(it['name'] for it in items)}{scope_flag(scope)}` in a terminal.")
    try_open(p["url"])
    print_instructions(items, p["url"], p["port"], scope)
    return 0


def cmd_wait(a):
    scope = scope_of(a)
    names = [check_name(n) for n in a.names]
    deadline = time.time() + a.timeout
    while True:
        done, waiting, lost = [], [], []
        for n in names:
            live = False
            for s in store.chain(scope):
                p = read_pending(s, n)
                if p and pending_live(p):
                    live = True
                elif p:  # page died or expired
                    clear_pending(s, n, p.get("token"))
            if live:
                waiting.append(n)
            else:
                (done if store.find(scope, n)[0] else lost).append(n)
        if lost and not waiting:
            if done:
                print("Stored: " + ", ".join(done))
            die("not stored and no live request: " + ", ".join(lost)
                + f". Run `secretctl request {' '.join(lost)}` again.", 1)
        if not waiting and not lost:
            print(("All stored" if len(names) > 1 else f"{names[0]} is stored")
                  + " (values hidden): " + ", ".join(done)
                  + f". Use with: secretctl run {names[0]} -- <command>")
            return 0
        if time.time() > deadline:
            if done:
                print("Stored so far: " + ", ".join(done))
            print("Still waiting for: " + ", ".join(waiting) + ". The link is still valid. Ask the user, then run "
                  f"`secretctl wait {' '.join(waiting)}` again.")
            return 4
        time.sleep(1)


def cmd_set(a):
    scope = scope_of(a)
    names = [check_name(n) for n in a.names]
    if (a.file or a.stdin) and len(names) > 1:
        die("--file/--stdin take one name at a time", 2)
    if not (a.file or a.stdin or sys.stdin.isatty()):
        die("stdin is not a terminal. Run this in your own terminal, or pass --stdin / --file.", 2)
    import getpass
    saved = 0
    for name in names:
        p = read_pending(scope, name) or {}
        if a.file:
            with open(os.path.expanduser(a.file)) as f:
                value = f.read().strip("\n")
        elif a.stdin:
            value = sys.stdin.read().strip("\n")
        else:
            g = p.get("guide") or {}
            if p.get("why") or g.get("steps") or g.get("where"):
                print(f"\n{name}" + (f": {p['why']}" if p.get("why") else ""))
                for i, s in enumerate(g.get("steps") or [], 1):
                    print(f"  {i}. {s}")
                if g.get("where"):
                    print(f"  → {g['where']}")
            value = getpass.getpass(f"Value for {name} (hidden, Enter to skip): ").strip()
        if not value:
            print(f"Skipped {name}.")
            continue
        store.save(scope, name, value, note=a.note or p.get("why", ""))
        clear_pending(scope, name)
        saved += 1
        print(f"Saved {name} {where(scope)} on {socket.gethostname()}.")
    return 0 if saved else 2


def print_entries(es: list[dict], shadowed: set[str] = frozenset()):
    if not es:
        print("  (none)")
    for e in es:
        when = time.strftime("%Y-%m-%d", time.localtime(e.get("created", 0)))
        note = f"  {e['note']}" if e.get("note") else ""
        flag = "  [overridden by project]" if e.get("name") in shadowed else ""
        print(f"  {e['name']:<32} {when}{note}{flag}")


def scope_heading(s: store.Scope) -> str:
    return "global  (shared by every project)" if s.is_global else f"{s.label}  ({s.root})"


def cmd_list(a):
    if a.all:
        groups = [(s, store.entries(s)) for s in store.all_scopes()]
        groups = [(s, es) for s, es in groups if es or s.is_global]
        if not any(es for _, es in groups):
            print("No secrets stored.")
            return 0
        for i, (s, es) in enumerate(groups):
            print(("\n" if i else "") + scope_heading(s))
            print_entries(es)
        return 0
    scope = scope_of(a)
    glob = store.entries(store.GLOBAL)
    if scope.is_global:
        if not glob:
            print("No global secrets stored. (Not in a project; `secretctl list --all` shows every project.)")
            return 0
        print(scope_heading(scope))
        print_entries(glob)
        return 0
    mine = store.entries(scope)
    print(scope_heading(scope))
    print_entries(mine)
    print("\n" + scope_heading(store.GLOBAL))
    print_entries(glob, {e["name"] for e in mine})
    return 0


def cmd_has(a):
    scope = scope_of(a)
    missing = []
    for n in a.names:
        e, s = store.find(scope, check_name(n))
        if e:
            print(f"{n}: stored {where(s)}")
        else:
            missing.append(n)
            print(f"{n}: not stored")
    return 1 if missing else 0


def cmd_rm(a):
    scope = scope_of(a)
    for n in a.names:
        check_name(n)
        clear_pending(scope, n)
        if store.remove(scope, n):
            print(f"Removed {n} {where(scope)}.")
        elif not scope.is_global and store.exists(store.GLOBAL, n):
            print(f"{n} is not stored for project {scope.label}. It's stored globally; "
                  f"remove that with: secretctl rm {n} --global")
        else:
            print(f"{n} was not stored {where(scope)}.")
    return 0


RUN_USAGE = "usage: secretctl run [--global | --project PATH] [VAR=]NAME ... -- command [args]"


def cmd_run(argv: list[str]):
    if "--" not in argv:
        die(RUN_USAGE, 2)
    i = argv.index("--")
    args, cmd = argv[:i], argv[i + 1:]
    glob, project, specs = False, None, []
    it = iter(args)
    for x in it:
        if x == "--global":
            glob = True
        elif x == "--project":
            project = next(it, None) or die(RUN_USAGE, 2)
        elif x.startswith("--project="):
            project = x.split("=", 1)[1]
        elif x.startswith("-"):
            die(f"unknown option {x}. " + RUN_USAGE, 2)
        else:
            specs.append(x)
    if not specs or not cmd:
        die(RUN_USAGE, 2)
    if glob and project:
        die("pass --global or --project, not both", 2)
    scope = resolve_scope(glob, project)
    env = dict(os.environ)
    missing = []
    for spec in specs:
        var, _, name = spec.partition("=") if "=" in spec else (spec, "", spec)
        check_name(name)
        e, _s = store.find(scope, name)
        if not e:
            missing.append(name)
            continue
        env[var] = e["value"]
    if missing:
        die("not stored " + where(scope) + ": " + ", ".join(missing)
            + ". Ask for them with: secretctl request " + " ".join(missing), 3)

    pairs = [(n.encode(), l.encode()) for n, l in store.redaction_pairs()]

    def redact(b: bytes) -> bytes:
        for n, l in pairs:
            if n in b:
                b = b.replace(n, l)
        return b

    try:
        proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        die(f"command not found: {cmd[0]}", 127)

    def pump(src, dst):
        for line in iter(src.readline, b""):
            dst.write(redact(line))
            dst.flush()

    threads = [threading.Thread(target=pump, args=(proc.stdout, sys.stdout.buffer), daemon=True),
               threading.Thread(target=pump, args=(proc.stderr, sys.stderr.buffer), daemon=True)]
    for t in threads:
        t.start()
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: proc.send_signal(s))
    code = proc.wait()
    for t in threads:
        t.join(timeout=2)
    return code


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "run":
        sys.exit(cmd_run(argv[1:]))

    ap = argparse.ArgumentParser(prog="secretctl", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="{request,wait,set,run,list,has,rm}")

    sp = argparse.ArgumentParser(add_help=False)
    sg = sp.add_mutually_exclusive_group()
    sg.add_argument("--global", dest="glob", action="store_true",
                    help="use the global scope, shared by every project")
    sg.add_argument("--project", metavar="PATH",
                    help="use the project PATH belongs to, instead of the current folder's")

    s = sub.add_parser("request", parents=[sp], help="ask the user for one or more secrets via a one-time link")
    s.add_argument("names", nargs="*")
    s.add_argument("--why", default="", help="what the key is for (shown to the user)")
    s.add_argument("--where", default="", help="URL of the page where the user gets the key")
    s.add_argument("--step", action="append", help="one step to find the key (repeatable, in order)")
    s.add_argument("--spec", help='JSON list [{"name","why","where","steps"}], or @file, or - for stdin')
    s.add_argument("--replace", action="store_true", help="ask again even if already stored")
    s.add_argument("--ttl", type=int, default=DEFAULT_REQUEST_TTL)
    s.set_defaults(fn=cmd_request)

    s = sub.add_parser("wait", parents=[sp], help="block until requested secrets are stored")
    s.add_argument("names", nargs="+"); s.add_argument("--timeout", type=int, default=540)
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("set", parents=[sp], help="store secrets (run in your own terminal)")
    s.add_argument("names", nargs="+"); s.add_argument("--note", default="")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--stdin", action="store_true"); g.add_argument("--file")
    s.set_defaults(fn=cmd_set)

    sub.add_parser("run", help="run a command with secrets as env vars: run [VAR=]NAME ... -- cmd")
    s = sub.add_parser("list", parents=[sp], help="list this project's and the global secret names")
    s.add_argument("--all", action="store_true", help="list every project's secrets")
    s.set_defaults(fn=cmd_list)
    for nm, fn, h in (("has", cmd_has, "exit 0 if all are stored (project or global)"),
                      ("rm", cmd_rm, "delete secrets from this project (or --global)")):
        s = sub.add_parser(nm, parents=[sp], help=h); s.add_argument("names", nargs="+"); s.set_defaults(fn=fn)

    s = sub.add_parser("_serve")
    s.add_argument("--token", required=True); s.add_argument("--spec", required=True)
    s.add_argument("--scope", default="{}")
    s.add_argument("--timeout", type=int, default=DEFAULT_REQUEST_TTL)
    s.set_defaults(fn=cmd_serve)

    a = ap.parse_args(argv)
    sys.exit(a.fn(a) or 0)


if __name__ == "__main__":
    main()
