#!/usr/bin/env python3
"""secretctl: let coding agents ask for secrets and use them without seeing them.

  secretctl request NAME [NAME...] [--why T] [--where URL] [--step T]...
  secretctl request --spec JSON|@file|-      several keys, each with its own why/where/steps
  secretctl wait NAME [NAME...]             block until the user has entered them all
  secretctl set NAME [NAME...]              user enters values in their own terminal
  secretctl run [VAR=]NAME ... -- CMD       run CMD with secrets as env vars, output redacted
  secretctl list [--all] | has NAME | rm NAME

Scopes: secrets belong to the current project (its git repo, or the folder
holding a .secretctl file) unless you pass --global. Lookups try the project
first, then global. --project PATH acts as if you were in PATH.

Values are never printed. Python 3.8+ stdlib only; works on Linux and macOS.
"""
from __future__ import annotations

import argparse
import html
import http.server
import json
import os
import platform
import re
import secrets as pysecrets
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.parse

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import secretstore as store  # noqa: E402

DEFAULT_PORT = 7787
DEFAULT_REQUEST_TTL = 900  # seconds a request link stays valid
MAX_BODY = 256 * 1024
MAX_KEYS = 20


def die(msg: str, code: int = 1):
    print(f"secretctl: {msg}", file=sys.stderr)
    sys.exit(code)


def check_name(name: str) -> str:
    if not store.valid_name(name):
        die(f"invalid name {name!r}: use UPPER_SNAKE_CASE, e.g. STRIPE_SECRET_KEY", 2)
    return name


def pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
        return True
    except (ProcessLookupError, PermissionError, TypeError, ValueError):
        return False


def resolve_scope(glob: bool = False, project: str | None = None) -> store.Scope:
    if glob:
        return store.GLOBAL
    if project:
        path = os.path.expanduser(project)
        if not os.path.isdir(path):
            die(f"--project {project!r} is not a folder", 2)
        s = store.project_scope(path)
        if s.is_global:
            die(f"{project} is not in a project (no git repo or {store.SCOPE_FILE} file). "
                "Pass --global to use the shared scope.", 2)
        return s
    return store.project_scope()


def scope_of(a) -> store.Scope:
    return resolve_scope(getattr(a, "glob", False), getattr(a, "project", None))


def scope_flag(scope: store.Scope) -> str:
    """The flag that points another shell (any folder) at this scope."""
    return " --global" if scope.is_global else f" --project {shlex.quote(scope.root)}"


def where(scope: store.Scope) -> str:
    return "globally" if scope.is_global else f"for project {scope.label}"


def read_pending(scope: store.Scope, name: str) -> dict | None:
    try:
        with open(store.pending_path(scope, name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def pending_live(p: dict | None) -> bool:
    return bool(p) and pid_alive(p.get("pid")) and p.get("expires", 0) > time.time()


def clear_pending(scope: store.Scope, name: str, token: str | None = None) -> None:
    """Drop a name from its request. The page notices and stops when nothing is left."""
    if token:
        p = read_pending(scope, name)
        if not p or p.get("token") != token:
            return
    try:
        store.pending_path(scope, name).unlink()
    except (FileNotFoundError, NotADirectoryError):
        pass


def is_orbstack() -> bool:
    return "orbstack" in platform.release().lower() or os.path.exists("/opt/orbstack-guest")


# ---------------------------------------------------------------- spec

def load_spec(a) -> list[dict]:
    """Normalise positional names, --why/--where/--step and --spec into [{name, why, where, steps}]."""
    items: list[dict] = []
    if a.spec:
        raw = a.spec
        if raw == "-":
            raw = sys.stdin.read()
        elif raw.startswith("@"):
            with open(os.path.expanduser(raw[1:])) as f:
                raw = f.read()
        try:
            data = json.loads(raw)
        except ValueError as e:
            die(f"--spec is not valid JSON: {e}", 2)
        if isinstance(data, dict):
            data = data.get("keys", [data])
        for d in data:
            if isinstance(d, str):
                d = {"name": d}
            items.append({"name": d.get("name", ""), "why": d.get("why", ""),
                          "where": d.get("where", ""), "steps": d.get("steps") or []})
    for n in a.names or []:
        items.append({"name": n, "why": a.why, "where": a.where, "steps": a.step or []})
    if not items:
        die("name at least one secret, e.g. secretctl request STRIPE_SECRET_KEY", 2)
    seen, out = set(), []
    for it in items:
        check_name(it["name"])
        if it["name"] in seen:
            continue
        seen.add(it["name"])
        if it["where"] and not re.match(r"^https?://\S+$", it["where"]):
            die(f"{it['name']}: where must be an http(s) URL, got {it['where']!r}", 2)
        if isinstance(it["steps"], str):
            it["steps"] = [it["steps"]]
        it["steps"] = [str(s).strip() for s in it["steps"] if str(s).strip()][:12]
        it["why"] = str(it["why"] or "")[:300]
        out.append(it)
    if len(out) > MAX_KEYS:
        die(f"at most {MAX_KEYS} secrets per request", 2)
    return out


# ---------------------------------------------------------------- web page
# Claude palette: Pampas/ivory light, warm charcoal dark, Crail-orange accent.

PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer"><title>{title}</title>
<style>
