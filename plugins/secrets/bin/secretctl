a.go{{display:inline-flex;align-items:center;gap:6px;margin-top:12px;color:var(--accent);font-weight:500;
text-decoration:none;font-size:14px}}a.go:hover{{color:var(--accent-hover);text-decoration:underline}}
input,textarea{{width:100%;margin-top:14px;padding:11px 12px;border:1px solid var(--line2);border-radius:10px;
background:var(--field);color:var(--text);font:14px ui-monospace,SFMono-Regular,Menlo,monospace}}
